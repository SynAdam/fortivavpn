{
  "manifest_version": 3,
  "name": "Fortiva VPN",
  "short_name": "Fortiva",
  "version": "0.0.0",
  "description": "Fortiva VPN for your browser. Connect with one click and browse through Fortiva.",
  "homepage_url": "https://fortivavpn.com",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "Fortiva VPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png"
    }
  },
  "background": {},
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "alarms",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}
