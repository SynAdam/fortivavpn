diff -ruN quic-go-base/http3/qpack_compat.go quic-go-patched/http3/qpack_compat.go
--- quic-go-base/http3/qpack_compat.go	1969-12-31 17:00:00
+++ quic-go-patched/http3/qpack_compat.go	2026-10-16 16:09:11
@@ -0,0 +1,33 @@
+package http3
+
+// [Fortiva] Psiphon's fork was written against quic-go/qpack v0.4, whose
+// Decoder had DecodeFull. Xray-core needs qpack v0.6, and a Go build can
+// hold only one version of a module, so this fork is built against v0.6.
+// decodeFull does what v0.4's DecodeFull did, using v0.6's Decode.
+
+import (
+	"errors"
+	"io"
+
+	"github.com/quic-go/qpack"
+)
+
+// decodeFull decodes a whole header block. Like v0.4's DecodeFull, an empty
+// block gives an empty slice and no error.
+func decodeFull(d *qpack.Decoder, p []byte) ([]qpack.HeaderField, error) {
+	if len(p) == 0 {
+		return []qpack.HeaderField{}, nil
+	}
+	next := d.Decode(p)
+	var fields []qpack.HeaderField
+	for {
+		hf, err := next()
+		if errors.Is(err, io.EOF) {
+			return fields, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		fields = append(fields, hf)
+	}
+}
diff -ruN quic-go-base/http3/server.go quic-go-patched/http3/server.go
--- quic-go-base/http3/server.go	2026-10-16 16:08:57
+++ quic-go-patched/http3/server.go	2026-10-16 16:09:11
@@ -626,7 +626,7 @@
 		str.CancelWrite(quic.StreamErrorCode(ErrCodeRequestIncomplete))
 		return
 	}
-	hfs, err := decoder.DecodeFull(headerBlock)
+	hfs, err := decodeFull(decoder, headerBlock)
 	if err != nil {
 		// TODO: use the right error code
 		conn.CloseWithError(quic.ApplicationErrorCode(ErrCodeGeneralProtocolError), "expected first frame to be a HEADERS frame")
