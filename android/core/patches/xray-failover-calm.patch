+// failoverTargetLocked picks the member a failing selection moves to, or nil when there is none.
+// It is the best measured alive member, with two exceptions. A suspect selection is only left for
+// a member that is calmer than it (see failoverCalm); a dead one takes any. And a member with the
+// exit of the one being left wins over a faster one with another exit, unless that one is faster by
+// the margin that replaces a healthy selection: each change of exit changes the address the user's
+// traffic leaves from.
+func (g *Group) failoverTargetLocked(cur *member, now time.Time) *member {
+	exit := g.cfg.exits[cur.tag]
+	var best, same *member
+	bestScore, sameScore := math.Inf(1), math.Inf(1)
+	for _, m := range g.members {
+		if m == cur || m.state != stateAlive {
+			continue
+		}
+		s, ok := m.score(now)
+		if !ok {
+			continue
+		}
+		if cur.state == stateSuspect && !calmerThan(m, cur, now) {
+			continue
+		}
+		if s < bestScore || (s == bestScore && m.order < best.order) {
+			best, bestScore = m, s
+		}
+		if exit != "" && g.cfg.exits[m.tag] == exit && (s < sameScore || (s == sameScore && m.order < same.order)) {
+			same, sameScore = m, s
+		}
+	}
+	if same != nil && !g.clearlyFaster(bestScore, sameScore) {
+		return same
+	}
+	return best
 }
 
+// calmerThan reports whether m is a better bet than the failing cur: it has not failed for
+// failoverCalm, or its recent connections fail clearly less often.
+func calmerThan(m, cur *member, now time.Time) bool {
+	if m.lastFailAt.IsZero() || now.Sub(m.lastFailAt) >= failoverCalm {
+		return true
+	}
+	return m.failRatio(now)+failoverRatioGap <= cur.failRatio(now)
+}
+
+// clearlyFaster reports whether a score beats another by the margin that replaces a healthy
+// selection: switch_ratio and switch_min_gain together.
+func (g *Group) clearlyFaster(score, than float64) bool {
+	return score <= than*(1-g.cfg.switchRatio) &&
+		than-score >= float64(g.cfg.switchMinGain)/float64(time.Millisecond)
+}
