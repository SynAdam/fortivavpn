+package autoselect
+
+import (
+	"testing"
+	"time"
+)
+
+// fail records n hard failures of real connections through tag, 300ms apart.
+func fail(g *Group, clock *fakeClock, tag string, n int) {
+	for i := 0; i < n; i++ {
+		clock.advance(ms(300))
+		g.recordOutcome(g.byTag[tag], outcomeStall, errNoResponse)
+	}
+}
+
+// succeed records n real connections through tag that went through.
+func succeed(g *Group, tag string, n int) {
+	for i := 0; i < n; i++ {
+		g.recordOutcome(g.byTag[tag], outcomeSuccess, nil)
+	}
+}
+
+// One phone: two Cloudflare doors that both failed now and then. Each time the
+// selected one failed twice, the core moved to the other, which had failed seconds before.
+func TestFlakyMembersDoNotTradePlaces(t *testing.T) {
+	g, clock := newPolicyGroup(t, &Config{Initial: "a"}, "a", "b")
+	probeOK(g, "a", 1600)
+	probeOK(g, "b", 1500)
+	clock.advance(time.Hour)
+	if got := g.pick(); got != "a" {
+		t.Fatalf("pick = %q, want a", got)
+	}
+
+	// A retry on b failed twice, then went through.
+	fail(g, clock, "b", 2)
+	succeed(g, "b", 1)
+	if g.byTag["b"].state != stateAlive {
+		t.Fatalf("b is %v after its traffic went through, want alive", g.byTag["b"].state)
+	}
+
+	switches := g.switches
+	fail(g, clock, "a", 2)
+	if g.byTag["a"].state != stateSuspect {
+		t.Fatalf("a is %v after two failures, want suspect", g.byTag["a"].state)
+	}
+	if got := g.selectedTag(); got != "a" {
+		t.Fatalf("moved to %q, which failed a second ago as often as a did", got)
+	}
+	if g.switches != switches {
+		t.Fatalf("%d switches, want none", g.switches-switches)
+	}
+}
+
+func TestASuspectSelectionMovesToAMemberThatHasBeenCalm(t *testing.T) {
+	g, clock := newPolicyGroup(t, &Config{Initial: "a"}, "a", "b")
+	probeOK(g, "a", 1600)
+	probeOK(g, "b", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "b", 2)
+	succeed(g, "b", 1)
+	clock.advance(failoverCalm)
+	fail(g, clock, "a", 2)
+	if got := g.selectedTag(); got != "b" {
+		t.Fatalf("selected %q, want b: its failures were more than %v ago", got, failoverCalm)
+	}
+}
+
+func TestASuspectSelectionMovesToAMemberThatFailsClearlyLessOften(t *testing.T) {
+	g, clock := newPolicyGroup(t, &Config{Initial: "a"}, "a", "b")
+	probeOK(g, "a", 1600)
+	probeOK(g, "b", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	// b failed once a moment ago, out of eight connections.
+	succeed(g, "b", 7)
+	fail(g, clock, "b", 1)
+	succeed(g, "b", 1)
+
+	// a fails most of what it carries. Bytes still arriving keep it suspect rather than dead.
+	succeed(g, "a", 1)
+	g.byTag["a"].lastBytesAt = clock.t
+	fail(g, clock, "a", 3)
+	if g.byTag["a"].state != stateSuspect {
+		t.Fatalf("a is %v, want suspect", g.byTag["a"].state)
+	}
+	if got := g.selectedTag(); got != "b" {
+		t.Fatalf("selected %q, want b: a fails 3 of 4, b 1 of 9", got)
+	}
+}
+
+// A dead selection carries nothing, so any working member is better than staying.
+func TestADeadSelectionLeavesForAMemberThatFailedRecently(t *testing.T) {
+	g, clock := newPolicyGroup(t, &Config{Initial: "a"}, "a", "b")
+	probeOK(g, "a", 1600)
+	probeOK(g, "b", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "b", 2)
+	succeed(g, "b", 1)
+	probeFail(g, "a")
+	probeFail(g, "a")
+	if g.byTag["a"].state != stateDead {
+		t.Fatalf("a is %v, want dead", g.byTag["a"].state)
+	}
+	if got := g.selectedTag(); got != "b" {
+		t.Fatalf("selected %q, want b: staying on a dead member is a blackout", got)
+	}
+}
+
+// One server's direct door x and Cloudflare door c10, and another server's Cloudflare door c11.
+func exitGroup(t *testing.T) (*Group, *fakeClock) {
+	cfg := &Config{
+		Initial: "x",
+		Exits:   map[string]string{"x": "10", "c10": "10", "c11": "11"},
+	}
+	g, clock := newPolicyGroup(t, cfg, "x", "c10", "c11")
+	return g, clock
+}
+
+func TestAFailoverKeepsTheExitWhenItCan(t *testing.T) {
+	g, clock := exitGroup(t)
+	probeOK(g, "x", 600)
+	probeOK(g, "c10", 1700)
+	probeOK(g, "c11", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "x", 2)
+	if got := g.selectedTag(); got != "c10" {
+		t.Fatalf("selected %q, want c10: same server, and c11 is only 200ms faster", got)
+	}
+}
+
+func TestAFailoverChangesTheExitForAMuchFasterMember(t *testing.T) {
+	g, clock := exitGroup(t)
+	probeOK(g, "x", 600)
+	probeOK(g, "c10", 2500)
+	probeOK(g, "c11", 900)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "x", 2)
+	if got := g.selectedTag(); got != "c11" {
+		t.Fatalf("selected %q, want c11: it is far faster than c10", got)
+	}
+}
+
+func TestAFailoverChangesTheExitWhenTheSameExitIsDown(t *testing.T) {
+	g, clock := exitGroup(t)
+	probeOK(g, "x", 600)
+	probeFail(g, "c10")
+	probeFail(g, "c10")
+	probeOK(g, "c11", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "x", 2)
+	if got := g.selectedTag(); got != "c11" {
+		t.Fatalf("selected %q, want c11: c10 is dead", got)
+	}
+}
+
+func TestMembersWithoutAnExitFailOverByScore(t *testing.T) {
+	g, clock := newPolicyGroup(t, &Config{Initial: "a"}, "a", "b", "c")
+	probeOK(g, "a", 600)
+	probeOK(g, "b", 1700)
+	probeOK(g, "c", 1500)
+	clock.advance(time.Hour)
+	g.pick()
+
+	fail(g, clock, "a", 2)
+	if got := g.selectedTag(); got != "c" {
+		t.Fatalf("selected %q, want c, the best scored", got)
+	}
+}
