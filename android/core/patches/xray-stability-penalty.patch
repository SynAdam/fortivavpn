+package autoselect_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/proxy/autoselect"
+)
+
+// The penalties setting reaches a running group from its JSON config: the faster member loses to
+// a slower one for its penalty, a tag the group does not hold is ignored, and the status says what
+// each member carries.
+func TestPenaltiesFromTheJSONConfig(t *testing.T) {
+	r := newRig(t, `"penalties":{"m0":1000,"gone":5000}`,
+		newFakeSocks(t, "ok", 5*time.Millisecond),
+		newFakeSocks(t, "ok", 60*time.Millisecond),
+	)
+	s := r.waitFor("m1 selected", 5*time.Second, func(s autoselect.GroupStatus) bool {
+		return s.Selected == "m1" && member(s, "m0").Samples > 0 && member(s, "m1").Samples > 0
+	})
+	if got := member(s, "m0").PenaltyMs; got != 1000 {
+		t.Errorf("m0 carries a penalty of %d, want 1000", got)
+	}
+	if got := member(s, "m1").PenaltyMs; got != 0 {
+		t.Errorf("m1 carries a penalty of %d, want none", got)
+	}
+}
diff -ruN xray-base/proxy/autoselect/stability_penalty_test.go xray-patched/proxy/autoselect/stability_penalty_test.go
--- xray-base/proxy/autoselect/stability_penalty_test.go
+++ xray-patched/proxy/autoselect/stability_penalty_test.go
@@ -0,0 +1,210 @@
+package autoselect
+
+import (
+	"encoding/json"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/features/outbound"
+)
+
+// handlerless resolves every member tag to no handler. That is enough for refreshMembersLocked,
+// which is where a running group gives each member its penalty.
+type handlerless struct{ outbound.Manager }
+
+func (handlerless) GetHandler(string) outbound.Handler { return nil }
+
+// penaltyGroup is newPolicyGroup with the members resolved the way a running group resolves them.
+func penaltyGroup(t *testing.T, cfg *Config, tags ...string) (*Group, *fakeClock) {
+	t.Helper()
+	cfg.Outbounds = tags
+	g, clock := newPolicyGroup(t, cfg)
+	g.ohm = handlerless{}
+	g.mu.Lock()
+	g.refreshMembersLocked(clock.t)
+	g.mu.Unlock()
+	if len(g.members) != len(tags) {
+		t.Fatalf("%d members, want %d", len(g.members), len(tags))
+	}
+	return g, clock
+}
+
+func scoreOf(g *Group, tag string) float64 {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	s, _ := g.byTag[tag].score(g.now())
+	return s
+}
+
+func planOf(g *Group) []string {
+	var tags []string
+	for _, st := range g.plan() {
+		tags = append(tags, st.m.tag)
+	}
+	return tags
+}
+
+// A Cloudflare door can answer its probes faster than an IPv6 Reality door and still be the
+// one sessions get cut on. With a 1000ms penalty the Reality door wins, as it would
+// against any Cloudflare door less than 1000ms faster than it.
+func TestAPenalizedDoorLosesToASlowerOneWithinItsPenalty(t *testing.T) {
+	g, _ := penaltyGroup(t, &Config{Penalties: map[string]int32{"cdn": 1000}}, "cdn", "v6")
+	probeOK(g, "cdn", 350)
+	probeOK(g, "v6", 600)
+	if got := g.pick(); got != "v6" {
+		t.Fatalf("pick = %q, want v6: 600ms beats 350ms with a 1000ms penalty", got)
+	}
+	if got := scoreOf(g, "cdn"); got != 1350 {
+		t.Fatalf("cdn scores %v, want 1350, its delay and its penalty", got)
+	}
+}
+
+// A penalty is a handicap, not a ban: a door slower than the penalized one by more than the
+// penalty still loses to it.
+func TestAPenalizedDoorWinsBeyondItsPenalty(t *testing.T) {
+	g, _ := penaltyGroup(t, &Config{Penalties: map[string]int32{"cdn": 1000}}, "cdn", "v6")
+	probeOK(g, "v6", 2500)
+	probeOK(g, "cdn", 350)
+	if got := g.pick(); got != "cdn" {
+		t.Fatalf("pick = %q, want cdn: 350ms with a 1000ms penalty beats 2500ms", got)
+	}
+}
+
+func TestNoPenaltiesChangeNothing(t *testing.T) {
+	for _, penalties := range []map[string]int32{nil, {}} {
+		g, _ := penaltyGroup(t, &Config{Penalties: penalties}, "cdn", "v6")
+		probeOK(g, "v6", 600)
+		probeOK(g, "cdn", 350)
+		if got := g.pick(); got != "cdn" {
+			t.Fatalf("penalties %v: pick = %q, want cdn, the faster", penalties, got)
+		}
+		if got := scoreOf(g, "cdn"); got != 350 {
+			t.Fatalf("penalties %v: cdn scores %v, want its delay alone", penalties, got)
+		}
+	}
+}
+
+// A penalty for a tag the group does not hold changes nothing, and neither does one of 0 or less:
+// below 0 it would be a bonus.
+func TestPenaltiesForOtherTagsOrBelowOneAreIgnored(t *testing.T) {
+	g, _ := penaltyGroup(t, &Config{Penalties: map[string]int32{"gone": 5000, "cdn": 0, "v6": -1000}}, "cdn", "v6")
+	probeOK(g, "v6", 600)
+	probeOK(g, "cdn", 350)
+	if got := g.pick(); got != "cdn" {
+		t.Fatalf("pick = %q, want cdn: no penalty applies to either door", got)
+	}
+	for _, tag := range []string{"cdn", "v6"} {
+		if p := g.byTag[tag].penalty; p != 0 {
+			t.Errorf("%s has a penalty of %v, want none", tag, p)
+		}
+	}
+	if got := scoreOf(g, "v6"); got != 600 {
+		t.Errorf("v6 scores %v, want 600", got)
+	}
+}
+
+// When the selection fails, it moves to the best member by the same score, so the Cloudflare door
+// the backend has seen fail in the middle of sessions is not where it goes.
+func TestAFailoverRespectsThePenalty(t *testing.T) {
+	for _, c := range []struct {
+		penalty int32
+		want    string
+	}{
+		{0, "cdn"},
+		{1000, "v6"},
+	} {
+		cfg := &Config{Initial: "x", Penalties: map[string]int32{"cdn": c.penalty}}
+		g, clock := penaltyGroup(t, cfg, "x", "cdn", "v6")
+		probeOK(g, "x", 200)
+		probeOK(g, "cdn", 350)
+		probeOK(g, "v6", 600)
+		clock.advance(time.Hour)
+		if got := g.pick(); got != "x" {
+			t.Fatalf("penalty %d: pick = %q, want x", c.penalty, got)
+		}
+		fail(g, clock, "x", 2)
+		if got := g.selectedTag(); got != c.want {
+			t.Errorf("penalty %d: failed over to %q, want %s", c.penalty, got, c.want)
+		}
+	}
+}
+
+// A failed connection is retried on the other members in the order of the same score.
+func TestRetriesFollowThePenalty(t *testing.T) {
+	for _, c := range []struct {
+		penalty int32
+		want    []string
+	}{
+		{0, []string{"x", "cdn", "v6"}},
+		{1000, []string{"x", "v6", "cdn"}},
+	} {
+		cfg := &Config{Initial: "x", MaxAttempts: 3, Penalties: map[string]int32{"cdn": c.penalty}}
+		g, clock := penaltyGroup(t, cfg, "x", "cdn", "v6")
+		probeOK(g, "x", 200)
+		probeOK(g, "cdn", 350)
+		probeOK(g, "v6", 600)
+		clock.advance(time.Second)
+		if got := planOf(g); !slices.Equal(got, c.want) {
+			t.Errorf("penalty %d: plan = %v, want %v", c.penalty, got, c.want)
+		}
+	}
+}
+
+// A penalty only reorders members that work. When every other door is down, the penalized one
+// carries the traffic, and a member that is dead or was never measured stays unranked whatever
+// its penalty.
+func TestAPenaltyNeverMakesADeadDoorWinOrAWorkingOneUnusable(t *testing.T) {
+	cfg := &Config{Initial: "v6", Penalties: map[string]int32{"cdn": 100000, "new": 5}}
+	g, clock := penaltyGroup(t, cfg, "v6", "cdn", "new")
+	probeOK(g, "v6", 600)
+	probeOK(g, "cdn", 350)
+	clock.advance(time.Hour)
+	if got := g.pick(); got != "v6" {
+		t.Fatalf("pick = %q, want v6", got)
+	}
+
+	probeFail(g, "v6")
+	probeFail(g, "v6")
+	if g.byTag["v6"].state != stateDead {
+		t.Fatalf("v6 is %v, want dead", g.byTag["v6"].state)
+	}
+	if got := g.selectedTag(); got != "cdn" {
+		t.Fatalf("selected %q, want cdn: it is the one door known to work, penalty or not", got)
+	}
+	if got := planOf(g); !slices.Equal(got, []string{"cdn", "new"}) {
+		t.Fatalf("plan = %v, want [cdn new]: a dead door is offered only when nothing else is left", got)
+	}
+	for _, tag := range []string{"v6", "new"} {
+		if _, ranked := g.byTag[tag].score(clock.t); ranked {
+			t.Errorf("%s is ranked; a dead or never measured member must not be", tag)
+		}
+	}
+}
+
+// The app reports each door's penalty with its measurements (door_states), so the backend can see
+// what the core was told next to what it chose.
+func TestTheStatusReportsEachPenalty(t *testing.T) {
+	g, _ := penaltyGroup(t, &Config{Penalties: map[string]int32{"cdn": 1000}}, "cdn", "v6")
+	probeOK(g, "cdn", 350)
+	probeOK(g, "v6", 600)
+	st := g.Status()
+	got := map[string]MemberStatus{}
+	for _, m := range st.Members {
+		got[m.Tag] = m
+	}
+	if m := got["cdn"]; m.PenaltyMs != 1000 || m.Score != 1350 {
+		t.Errorf("cdn status: penalty %d score %v, want 1000 and 1350", m.PenaltyMs, m.Score)
+	}
+	if m := got["v6"]; m.PenaltyMs != 0 || m.Score != 600 {
+		t.Errorf("v6 status: penalty %d score %v, want 0 and 600", m.PenaltyMs, m.Score)
+	}
+	raw, err := json.Marshal(st)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), `"penaltyMs":1000`) {
+		t.Errorf("status JSON has no penaltyMs: %s", raw)
+	}
+}
