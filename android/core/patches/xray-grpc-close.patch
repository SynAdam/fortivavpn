diff --color -ruN xray-base/transport/internet/memory_settings.go xray-patched/transport/internet/memory_settings.go
--- xray-base/transport/internet/memory_settings.go	2026-11-04 05:52:01
+++ xray-patched/transport/internet/memory_settings.go	2026-11-04 05:52:21
@@ -1,6 +1,9 @@
 package internet
 
 import (
+	"sync"
+	"sync/atomic"
+
 	"github.com/xtls/xray-core/common/net"
 	"github.com/xtls/xray-core/transport/internet/finalmask"
 )
@@ -17,6 +20,46 @@
 	QuicParams       *QuicParams
 	SocketSettings   *SocketConfig
 	DownloadSettings *MemoryStreamConfig
+
+	// Set by Release.
+	released atomic.Bool
+}
+
+var (
+	releaseHooksAccess sync.RWMutex
+	releaseHooks       []func(*MemoryStreamConfig)
+)
+
+// RegisterReleaseHook adds a function that Release calls for every
+// MemoryStreamConfig it releases. A transport that keeps connections for a
+// MemoryStreamConfig longer than one dial registers one from its init, to
+// close them.
+func RegisterReleaseHook(hook func(*MemoryStreamConfig)) {
+	releaseHooksAccess.Lock()
+	defer releaseHooksAccess.Unlock()
+	releaseHooks = append(releaseHooks, hook)
+}
+
+// Release says that the outbound that owns these settings has closed. It runs
+// every registered hook once, so each transport closes what it keeps for
+// these settings. After it, Released reports true, and a transport must not
+// keep anything new for them. Only the first call does anything, and a nil
+// MemoryStreamConfig is ignored.
+func (s *MemoryStreamConfig) Release() {
+	if s == nil || !s.released.CompareAndSwap(false, true) {
+		return
+	}
+	releaseHooksAccess.RLock()
+	hooks := releaseHooks
+	releaseHooksAccess.RUnlock()
+	for _, hook := range hooks {
+		hook(s)
+	}
+}
+
+// Released reports whether Release has been called.
+func (s *MemoryStreamConfig) Released() bool {
+	return s != nil && s.released.Load()
 }
 
 // ToMemoryStreamConfig converts a StreamConfig to MemoryStreamConfig. It returns a default non-nil MemoryStreamConfig for nil input.
