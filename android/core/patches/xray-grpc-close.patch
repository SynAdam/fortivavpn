 	}
 	globalDialerMap[dialerConf{dest, streamSettings}] = conn
 	return conn, err
+}
+
+// closeClients closes and forgets every client made for streamSettings. It
+// is the release hook: the outbound that owns streamSettings has closed. The
+// clients are closed outside the lock, so dials of other outbounds do not wait
+// for them.
+func closeClients(streamSettings *internet.MemoryStreamConfig) {
+	var clients []*grpc.ClientConn
+	globalDialerAccess.Lock()
+	for key, client := range globalDialerMap {
+		if key.MemoryStreamConfig == streamSettings {
+			delete(globalDialerMap, key)
+			if client != nil {
+				clients = append(clients, client)
+			}
+		}
+	}
+	globalDialerAccess.Unlock()
+	for _, client := range clients {
+		client.Close()
+	}
 }
 
