<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (see src/debug/AndroidManifest.xml). -->
<network-security-config>
    <!-- A local backend: 10.0.2.2 is the emulator's name for the computer
         it runs on, and 127.0.0.1 reaches it from a phone through
         adb reverse. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <!-- Everything else stays as src/main has it. A config file replaces
         usesCleartextTraffic there, and the check that the tunnel works
         fetches a plain http page, so turning cleartext off here would
         make every connect in a debug build fail that check. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
